/* =========================================
   DBS Workstation Clinical Theme
   HOW TO CUSTOMIZE:
   - Colors: Change hex values below
   - Fonts: Change font-family & font-size
   - Spacing: Adjust padding/margin values
   - Tables: Modify QTableWidget & QHeaderView blocks
   ========================================= */

QWidget {
    background-color: #000000;
    color: #cdd6f4;
    font-family: "Segoe UI", "Roboto", "Arial", sans-serif;
    font-size: 13px;
}

QGroupBox {
    font-weight: 600;
    border: 1px solid #45475a;
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 16px;
    background-color: #181825;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
    color: #89b4fa;
    font-size: 14px;
}

QPushButton {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 10px 18px;
    font-weight: 500;
    min-height: 28px;
}
QPushButton:hover { background-color: #45475a; border-color: #89b4fa; }
QPushButton:pressed { background-color: #585b70; }
QPushButton:disabled {
    background-color: #2a2a3c;
    color: #6c7086;
    border-color: #313244;
}

QTableWidget {
    background-color: #181825;
    border: 1px solid #45475a;
    border-radius: 6px;
    gridline-color: #313244;
    selection-background-color: #89b4fa;
    selection-color: #1e1e2e;
    alternate-background-color: #1e1e2e;
    font-size: 12px;
}
QTableWidget::item { padding: 8px; border-bottom: 1px solid #313244; }
QHeaderView::section {
    background-color: #313244;
    color: #cdd6f4;
    padding: 10px;
    border: none;
    border-bottom: 2px solid #89b4fa;
    font-weight: 600;
    font-size: 12px;
}

QProgressBar {
    border: 1px solid #45475a;
    border-radius: 6px;
    background-color: #313244;
    text-align: center;
    height: 24px;
    font-size: 11px;
}
QProgressBar::chunk { background-color: #a6e3a1; border-radius: 5px; }

QLabel { color: #cdd6f4; }
QSplitter::handle { background-color: #45475a; border-radius: 2px; }
QSplitter::handle:horizontal { width: 6px; }

QMainWindow, QDialog { background-color: #1e1e2e; }
QStatusBar {
    background-color: #181825;
    border-top: 1px solid #45475a;
    color: #a6adc8;
    font-size: 12px;
    padding: 4px 8px;
}